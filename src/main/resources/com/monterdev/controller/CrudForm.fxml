               </font>
            </Button>
            <TextArea fx:id="txtProductUnit" prefHeight="200.0" prefWidth="200.0" promptText="UNIT(8x1)" style="-fx-font-size: 20;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
