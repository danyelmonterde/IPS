<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.monterdev.controller.CrudController">
   <children>
      <GridPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <TextArea fx:id="textCode" prefHeight="200.0" prefWidth="241.0" promptText="CODE" style="-fx-font-size: 20;" wrapText="true" />
            <TextArea fx:id="textBeginBal" prefHeight="200.0" prefWidth="200.0" promptText="BEGINBALANCE" style="-fx-font-size: 20;" GridPane.columnIndex="2" />
            <TextArea fx:id="textReorder" prefHeight="200.0" prefWidth="200.0" promptText="REORDERLIMIT" style="-fx-font-size: 20;" GridPane.columnIndex="3" />
            <TextArea fx:id="txtPurchased" prefHeight="200.0" prefWidth="200.0" promptText="QTY PURCHASED" style="-fx-font-size: 20;" GridPane.rowIndex="1" />
            <TextArea fx:id="txtSold" prefHeight="200.0" prefWidth="200.0" promptText="QTY SOLD" style="-fx-font-size: 20;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextArea fx:id="txtDescription" prefHeight="200.0" prefWidth="200.0" promptText="SADDLE CLAMP" style="-fx-font-size: 20;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextArea fx:id="txtAcquisition" prefHeight="200.0" prefWidth="200.0" promptText="ACQUISITION COST/UNIT" style="-fx-font-size: 20;" GridPane.rowIndex="2" />
            <TextArea fx:id="txtTotal" prefHeight="200.0" prefWidth="200.0" promptText="TOTAL" style="-fx-font-size: 20;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextArea fx:id="txtOtherMaintenance" prefHeight="200.0" prefWidth="200.0" promptText="OTHER MAINTENANCE" style="-fx-font-size: 20;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextArea fx:id="txtEndBalance" prefHeight="200.0" prefWidth="200.0" promptText="END BALANCE" style="-fx-font-size: 20;" GridPane.rowIndex="3" />
            <TextArea fx:id="txtAmountOfStocks" prefHeight="200.0" prefWidth="200.0" promptText="AMOUNT OF STOCKS" style="-fx-font-size: 20;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <ButtonBar prefHeight="40.0" prefWidth="200.0" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            <TextArea fx:id="txtProductCategory" prefHeight="200.0" prefWidth="200.0" promptText="PRODUCT CATEGORY" style="-fx-font-size: 20;" GridPane.columnIndex="1" />
          <Button fx:id="buttonSend" alignment="CENTER" contentDisplay="CENTER" defaultButton="true" mnemonicParsing="false" onAction="#sendData" text="SEND" GridPane.columnIndex="2" GridPane.rowIndex="3">
